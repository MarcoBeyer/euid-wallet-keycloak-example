# Docker ignore file for optimized builds
# Note: target/ is conditionally ignored - keep the built JAR if it exists

.git/
.github/
*.md
.gitignore
docker-compose.yml
Dockerfile
.dockerignore

# Build artifacts (except the final JAR which we may want to use)
target/classes/
target/generated-sources/
target/maven-status/
target/test-classes/
target/surefire-reports/
target/*-sources.jar
target/original-*.jar
target/dependency-reduced-pom.xml

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Environment files (keep .env.example)
.env