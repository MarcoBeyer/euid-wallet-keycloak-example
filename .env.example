# =======================================================================
# EUID Wallet Keycloak Example - Environment Configuration
# =======================================================================

# -----------------------------------------------------------------------
# Keycloak Configuration
# -----------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_password

# -----------------------------------------------------------------------
# OpenID4VP Provider Configuration
# -----------------------------------------------------------------------
# Wallet endpoint for OpenID4VP integration
# In production, replace with your actual wallet endpoint
WALLET_ENDPOINT=https://wallet.example.com

# Trusted PID issuers (comma-separated list)
# In production, replace with real trusted issuer DIDs
TRUSTED_ISSUERS=did:web:issuer1.gov.example,did:web:issuer2.gov.example,did:web:member-state.eu

# Security settings
REQUIRE_AGE_VERIFICATION=true
MAX_VP_TOKEN_SIZE=102400
VALIDATION_TIMEOUT=30

# -----------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------
# Set to false in production
KC_DEV_MODE=false

# Logging level (DEBUG, INFO, WARN, ERROR)
KC_LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------
# Keycloak port (external)
KEYCLOAK_PORT=8080

# Mock wallet port (for testing only)
MOCK_WALLET_PORT=8081

# -----------------------------------------------------------------------
# Production Settings (uncomment for production use)
# -----------------------------------------------------------------------
# KC_HOSTNAME=your-keycloak-domain.com
# KC_DB_URL=jdbc:postgresql://your-db-host:5432/keycloak
# KC_HTTPS_CERTIFICATE_FILE=/path/to/certificate.pem
# KC_HTTPS_CERTIFICATE_KEY_FILE=/path/to/private-key.pem